{
  "name": "sonara",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "description": "Sonara, a video-first music app and discovery service",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "server:lan": "node server.js --lan",
    "mobile": "expo start --dev-client --lan",
    "build:android:dev": "eas build --platform android --profile development"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-mobile-ads/facebook": "^17.4.0",
    "@react-native-google-mobile-ads/pangle": "^17.4.0",
    "expo": "~58.0.20",
    "expo-audio": "~58.0.9",
    "expo-dev-client": "~58.0.17",
    "expo-video": "^58.0.12",
    "ffmpeg-static": "^5.3.0",
    "onesignal-expo-plugin": "^2.8.0",
    "react": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-onesignal": "^5.5.16",
    "react-native-safe-area-context": "~5.10.1",
    "yt-search": "^2.13.1"
  },
  "overrides": {
    "minimatch": "3.1.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
