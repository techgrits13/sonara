PORT=5000
HOST=127.0.0.1
SESSION_DAYS=30
MEDIA_DIR=./media
PYTHON_PATH=python
# Add the Supabase project URL and publishable key when ready.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials. Never use the service role key in the Expo app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Native ads and push require a custom development build; replace these with your own IDs.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ONESIGNAL_APP_ID=
# Optional override when FFmpeg is installed outside the bundled package.
# FFMPEG_PATH=
